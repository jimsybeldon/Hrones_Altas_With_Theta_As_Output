# ----------------------------------------------------------------------
# PLOTTING: COUPLER PATH + PRECISION POINTS + DESIGN-ANGLE POINTS
# ----------------------------------------------------------------------

import matplotlib.pyplot as plt

def plot_coupler_path_with_precision(a, b, c, AD, u, v):
    """
    Plot:
      - full coupler path P(theta)
      - precision points (red X)
      - actual coupler points at design angles (blue circles)
    """

    # Full path
    thetas, P_arr = coupler_point_path(a, b, c, AD, u, v)

    # Design-angle coupler points
    A = np.array([0.0, 0.0])
    D = np.array([AD, 0.0])
    cp_local = np.array([u, v])

    design_pts = []
    C_prev = None

    for theta in THETA_DESIGN:
        B, C_candidates = fk_positions(theta, A, D, a, b, c)
        if not C_candidates:
            design_pts.append((np.nan, np.nan))
            continue

        C = C_candidates[0] if C_prev is None else choose_by_continuity(C_prev, C_candidates)
        C_prev = C

        dx = C[0] - B[0]
        dy = C[1] - B[1]
        phi = np.arctan2(dy, dx)

        R = np.array([
            [np.cos(phi), -np.sin(phi)],
            [np.sin(phi),  np.cos(phi)],
        ])

        P = B + R @ cp_local
        design_pts.append(P)

    design_pts = np.array(design_pts)

    # Plot
    plt.figure(figsize=(8, 6))
    plt.plot(P_arr[:,0], P_arr[:,1], 'k-', linewidth=2, label="Coupler Path")

    # Precision points
    px = [p[0] for p in PRECISION_POINTS]
    py = [p[1] for p in PRECISION_POINTS]
    plt.scatter(px, py, color='red', marker='x', s=100, label="Precision Points")

    # Actual coupler points at design angles
    plt.scatter(design_pts[:,0], design_pts[:,1], color='blue', s=80, label="Coupler @ Design Angles")

    plt.title(f"Coupler Path (u={u:+.3f}, v={v:+.3f})")
    plt.xlabel("X")
    plt.ylabel("Y")
    plt.axis('equal')
    plt.grid(True)
    plt.legend()
    plt.show()
```

